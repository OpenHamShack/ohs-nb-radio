# OpenHamShack Radio, the store form: `python3 -m ohsradio --server`.
#
# Built by tools/build-store.sh from a staged copy of one commit (this
# folder's files at the top, with ohscore/, ohsradio/ and tools/vendor/ beside
# them), never from a working tree, and carried in the signed package so a
# controller with no route out can install it (D12).
#
# x86_64 only (Brian, 30/10/2026: "drop arm completely"). Every box is
# x86_64 and every store build runs on one; an arm64 image was never built
# or tested, so each stage below refuses anything else at its first step
# rather than half-building.
#
# Debian 13, as the .deb is tested on: Debian's numpy, libiio 0.26 and
# libad9361 for the Pluto, codec2 for FreeDV, cryptography for nothing here
# but kept because ohscore imports it lazily for update checks. No PyQt, no
# PortAudio, no sound card: audio goes over the API (ohscore/server/audio.py).

# >>> sdrplay-in-image (tools/build-store.sh deletes from here to the
# matching "<<<" line unless SHACK_STORE_DROP_SDRPLAY=0: RADIO-SDR-PLAN 6.3.
# Since 23/10/2026 a Radio image carries nothing of SDRplay's - the API and
# its service come from the controller's host library sdrplay-api - so this
# stage is built only for an image asked for the old way.)
# The SDRplay receivers (an RSPdx on ohs-box, 12/10/2026), through SoapySDR
# like any receive-only SDR (ohscore/devices/soapy.py). Debian has SoapySDR
# but neither SDRplay's API nor SoapySDRPlay3, so this stage installs the
# API from SDRplay's installer and builds the module against it; the image
# below takes only the results. Both arrive in sdrplay/ beside this file,
# copied by tools/build-store.sh and checked here against
# tools/vendor/sdrplay.lock before anything is unpacked. The installer is
# unpacked, never run: it wants sudo, systemd and udev, none of which a
# container has, and all it would do is copy these same files.
FROM docker.io/library/debian:13-slim AS sdrplay
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make libsoapysdr-dev \
    && rm -rf /var/lib/apt/lists/*
COPY sdrplay/ /src/
COPY tools/vendor/sdrplay.lock /src/
RUN set -e; cd /src \
    && grep -v '^#' sdrplay.lock | sha256sum -c - \
    && { [ "$(uname -m)" = x86_64 ] || { echo "Store Radio is built for x86_64 only, not $(uname -m)"; exit 1; }; } \
    && arch=amd64 \
    && sh ./SDRplay_RSP_API-Linux-*.run --noexec --target api >/dev/null \
    && lib="$(cd api/$arch && ls libsdrplay_api.so.*)" \
    && mkdir -p /out/usr/local/lib /out/usr/local/bin /out/usr/share/doc/sdrplay-api \
    && install -m 0644 "api/$arch/$lib" /out/usr/local/lib/ \
    && ln -s "$lib" /out/usr/local/lib/libsdrplay_api.so.3 \
    && ln -s libsdrplay_api.so.3 /out/usr/local/lib/libsdrplay_api.so \
    && install -m 0755 "api/$arch/sdrplay_apiService" /out/usr/local/bin/ \
    && install -m 0644 api/sdrplay_license.txt /out/usr/share/doc/sdrplay-api/ \
    && cp api/inc/sdrplay_api*.h /usr/local/include/ \
    && cp -a /out/usr/local/lib/. /usr/local/lib/ \
    && tar xzf SoapySDRPlay3-*.tar.gz \
    && cmake -S SoapySDRPlay3-soapy-sdrplay3-* -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build build -j"$(nproc)" \
    && DESTDIR=/out cmake --install build \
    && install -m 0644 SoapySDRPlay3-soapy-sdrplay3-*/LICENSE.txt /out/usr/share/doc/sdrplay-api/SoapySDRPlay3-LICENSE.txt
# <<< sdrplay-in-image

# SatDump's command line, for the weather-satellite pictures
# (ohsradio/wxsat_decode.py; Brian, 29/10/2026: use the library, write no
# decoder of our own). Built here from SatDump's source with two patches of
# ours (Brian, 30/10/2026: "write our own version and fix it and we'll just
# use that"), where until 0.1.22-beta.27 it was Debian 13's satdump 1.2.2
# packages, unpacked.
#
# Why: from 30/10/2026 Meteor-M N2-3 passes decoded to dataset.json
# "timestamp": -1, every projection logged "Solving TPS equations for 0
# GCPs... Failure solving!", and MCIR came out black. Two faults in 1.2.2,
# both in satdump/ beside this file, with the reasons in each patch:
#   01-meteor-m2x-channel-offset.patch - MSU-MR channels were cut each from
#     its own first segment, and their offsets in the 43-packet loop taken
#     "% 43 % 14", so a pass that began mid-loop (that evening's: channels
#     1, 2 and 4 since 30/10, 1, 2 and 3 before) had them a line apart.
#     The same idea as upstream's "LRPT alignment rework" (b0fd1359b and
#     e6661066a, on master by 9fee0793c7d4), written onto 1.2.2's reader:
#     upstream's commits come with 2.0's product rework.
#   02-lrpt-timestamp-median.patch - what actually blackened that pass: it
#     lost signal for half its lines, a line with no data has the timestamp
#     -1, and the projection's filter and the dataset took the median over
#     every line, so -1, and then threw away every real timestamp. Upstream
#     master still does this.
# Drop 01 with the first SatDump release containing b0fd1359b, and 02 when
# upstream's timestamp filter skips -1; until then a new pin means checking
# both still apply (git apply fails the build if not) and still matter.
#
# Pinned: tag 1.2.2, commit 7aef0fe8441bc3eb440b1b6ba053556da5e40991 of
# github.com/SatDump/SatDump (GPL-3.0); the build fails if the tag ever
# names another commit. Upstream 1.2 only: the output tree wxsat_decode.py
# reads and its tests' fake SatDump reproduces are 1.2's.
#
# Only what `satdump meteor_m2-x_lrpt baseband ...` loads is built: the CLI
# (no GUI), its core library, the Meteor plugin, the C++ composites plugin
# (MCIR and MSA) and the SIMD ones where the architecture has them - no SDR
# or audio plugin, no OpenCL. Debian's package carries the GUI and every
# SDR it can drive, hundreds of MB for a program that only ever reads a
# file here. Then the Meteor pipeline, the stock settings and the few
# resources the MSU-MR products read (projection settings, LUTs, scripted
# composites, one font, one map, and Natural Earth's borders, coasts and
# towns), the same files as Debian's (its LUT PNGs are recompressed, the
# pixels identical). The borders are not optional however the settings ask
# for no overlay: 1.2.2 draws one on some products regardless, and without
# ne_10m_admin_0_countries.shp it logs "does not exist!" and then spins one
# core for ever with every picture already written (the Tablet session,
# 30/10/2026). The image below installs the libraries those link.
#
# The licence: Debian's copyright file for 1.2.2, as the image has always
# carried it (it lists every third-party file in the source, with its
# authors' addresses - which is why it is fetched from Debian's package here
# rather than kept in this repository, whose published source tarball
# refuses personal mail addresses: packaging/source-scrub.txt), SatDump's own LICENSE,
# the patches, and a SOURCE note naming the commit they apply to.
FROM docker.io/library/debian:13-slim AS satdump
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make pkg-config git ca-certificates \
        libjemalloc-dev libvolk-dev libnng-dev libarmadillo-dev libpng-dev libfftw3-dev \
        libzstd-dev libcurl4-openssl-dev libtiff-dev \
    && cd /tmp && apt-get download satdump && dpkg-deb -f satdump_*.deb Version | grep -q '^1\.2\.2-' \
    && dpkg-deb --fsys-tarfile satdump_*.deb | tar -x -O ./usr/share/doc/satdump/copyright > /copyright \
    && test -s /copyright && rm satdump_*.deb \
    && rm -rf /var/lib/apt/lists/*
COPY satdump/ /patches/
RUN set -e; git clone -q --depth 1 --branch 1.2.2 https://github.com/SatDump/SatDump /src \
    && test "$(git -C /src rev-parse HEAD)" = 7aef0fe8441bc3eb440b1b6ba053556da5e40991 \
    && { [ "$(uname -m)" = x86_64 ] || { echo "Store Radio is built for x86_64 only, not $(uname -m)"; exit 1; }; } \
    && git -C /src apply /patches/01-meteor-m2x-channel-offset.patch /patches/02-lrpt-timestamp-median.patch \
    && off="" && for o in AIRSPY_SDR AIRSPYHF_SDR HACKRF_SDR LIMESDR_SDR SDRPLAY_SDR PLUTOSDR_SDR BLADERF_SDR \
         USRP_SDR RTLSDR_SDR MIRISDR_SDR SDDC_SDR SOAPY_SDR RFNM_SDR NET_SOURCE_SDR REMOTE_SDR; do \
         off="$off -DPLUGIN_${o}_SUPPORT=OFF"; done \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
         -DBUILD_GUI=OFF -DBUILD_OPENCL=OFF -DPLUGINS_ALL=OFF -DPLUGIN_METEOR=ON -DPLUGIN_STANDARD_CPP_COMPOS=ON \
         -DPLUGIN_SIMD_NEON=OFF -DPLUGIN_SPYSERVER_SUPPORT=OFF -DPLUGIN_RTLTCP_SUPPORT=OFF \
         -DPLUGIN_SDRPP_SERVER_SUPPORT=OFF -DPLUGIN_PORTAUDIO_SINK=OFF -DPLUGIN_AAUDIO_SINK=OFF $off >/dev/null \
    && { cmake --build /build -j"$(nproc)" >/build.log 2>&1 || { tail -40 /build.log; exit 1; }; } \
    && DESTDIR=/x cmake --install /build >/dev/null \
    && L="usr/lib/$(uname -m)-linux-gnu" && R=usr/share/satdump/resources \
    && mkdir -p /out/usr/bin "/out/$L/satdump/plugins" /out/usr/share/satdump/pipelines \
         /out/$R/maps /out/$R/fonts /out/$R/projections_settings /out/usr/share/doc/satdump/patches \
    && cp /x/usr/bin/satdump /out/usr/bin/ \
    && cp "/x/$L/libsatdump_core.so" "/out/$L/" \
    && for p in meteor cpp_compos simd_avx2 simd_sse41; do \
         f="/x/$L/satdump/plugins/lib${p}_support.so"; [ -e "$f" ] || f="/x/$L/satdump/plugins/lib${p}.so"; \
         if [ -e "$f" ]; then cp "$f" "/out/$L/satdump/plugins/"; \
         elif [ "$p" = meteor ] || [ "$p" = cpp_compos ]; then echo "no $p plugin"; exit 1; fi; \
       done \
    && cp /x/usr/share/satdump/satdump_cfg.json /out/usr/share/satdump/ \
    && cp /x/usr/share/satdump/pipelines/Meteor-M.json /out/usr/share/satdump/pipelines/ \
    && cp -r /x/$R/lut /x/$R/scripted_compos /out/$R/ \
    && cp /x/$R/projections_settings/meteor_* /out/$R/projections_settings/ \
    && cp /x/$R/fonts/font.ttf /out/$R/fonts/ && cp /x/$R/maps/nasa_hd.jpg /out/$R/maps/ \
    && cp /x/$R/maps/ne_10m_admin_0_countries.shp /x/$R/maps/ne_10m_coastline.shp \
         /x/$R/maps/ne_10m_populated_places_simple.json /out/$R/maps/ \
    && strip --strip-unneeded /out/usr/bin/satdump "/out/$L/libsatdump_core.so" "/out/$L/satdump/plugins/"*.so \
    && cp /copyright /src/LICENSE /out/usr/share/doc/satdump/ \
    && cp /patches/*.patch /out/usr/share/doc/satdump/patches/ \
    && echo "SatDump 1.2.2 (7aef0fe8441bc3eb440b1b6ba053556da5e40991, https://github.com/SatDump/SatDump) with the OpenHamShack patches in patches/, applied in order" \
         > /out/usr/share/doc/satdump/SOURCE

# radiosonde_auto_rx's programs, for Radio's radiosondes (ohsradio/sonde.py;
# Brian, 29/10/2026: no sonde demodulator of our own). Pinned: tag v1.9.0,
# commit 53d03c72ad18ce4357c0cedd1f4acf2bf1efb36e of
# github.com/projecthorus/radiosonde_auto_rx (GPL-3.0); the build fails if
# the tag ever names another commit. Only what sonde.py runs is built, as
# auto_rx's own build.sh builds it: dft_detect (which kind of sonde),
# iq_dec, fsk_demod, and the RS41, DFM, M10/M20, LMS6, iMet-54 and Meisei
# demodulators - about 650 kB, linking only libc and libm. VER_JSN_STR is
# the version every decoder line carries; sonde.AUTO_RX_VERSION refuses
# lines from any other, so a new pin changes both together. Built to
# /opt/shack-radio/sonde, sonde.BIN_DIR.
FROM docker.io/library/debian:13-slim AS sonde
RUN apt-get update && apt-get install -y --no-install-recommends gcc make libc6-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN set -e; git clone -q --depth 1 --branch v1.9.0 https://github.com/projecthorus/radiosonde_auto_rx /src \
    && test "$(git -C /src rev-parse HEAD)" = 53d03c72ad18ce4357c0cedd1f4acf2bf1efb36e \
    && export CFLAGS='-O3 -w -Wno-unused-variable -DVER_JSN_STR="\"1.9.0\""' \
    && make -C /src/demod/mod rs41mod dfm09mod m10m20mod lms6Xmod imet54mod meisei100mod iq_dec \
    && make -C /src/utils fsk_demod && make -C /src/scan dft_detect \
    && mkdir -p /out/opt/shack-radio/sonde /out/usr/share/doc/radiosonde-auto-rx \
    && cd /src && install -m 0755 demod/mod/rs41mod demod/mod/dfm09mod demod/mod/m10m20mod demod/mod/lms6Xmod \
         demod/mod/imet54mod demod/mod/meisei100mod demod/mod/iq_dec utils/fsk_demod scan/dft_detect \
         /out/opt/shack-radio/sonde/ \
    && install -m 0644 LICENSE /out/usr/share/doc/radiosonde-auto-rx/ \
    && echo "radiosonde_auto_rx v1.9.0 (53d03c72ad18ce4357c0cedd1f4acf2bf1efb36e), https://github.com/projecthorus/radiosonde_auto_rx" \
         > /out/usr/share/doc/radiosonde-auto-rx/SOURCE

FROM docker.io/library/debian:13-slim

# libopenblas0-pthread: Debian's numpy links the reference BLAS unless an
# optimised one is installed (the alternatives system then picks it). The
# CW skimmer's neural engine is small matrix products every 20 ms on every
# channel: on ohs-box the reference BLAS cost 0.36 % of a core a channel,
# OpenBLAS half that (14/10/2026). One BLAS thread (OPENBLAS_NUM_THREADS
# below): the products are too small to share, and spare threads would
# spin on cores the other apps use.
# librtlsdr0: the RTL-SDR receiver (device rtlsdr, shack_sdr's ctypes
# binding); its udev rule is the controller's (Host -> Hardware), not this
# image's. SDRplay's API is never apt's: the controller's host library
# mounted at /opt/hostlibs/sdrplay-api (entrypoint.sh), or in an image built
# the old way the sdrplay-in-image blocks' copy. python3-soapysdr for the
# soapy device: with no SDRplay module in the image, `device` soapy with
# driver=sdrplay opens the RSP through shack_sdr's binding instead
# (ohscore/devices/sdrsource.py SoapySdrplayDevice), and SoapySDR is what
# says the module is absent; soapysdr-tools for SoapySDRUtil, which is how
# to see from a shell on the controller what the container can find
# (podman exec ... SoapySDRUtil --find).
# python3-jsonschema for shack_ui, which checks every ui/1 screen against
# the pinned schema as it is served (Document.to_json), so a screen that
# would break a client is a 500 here rather than a broken TV page; Debian
# 13's 4.19 meets the wheel's >=4.18.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-numpy \
        libopenblas0-pthread \
        python3-paramiko \
        python3-libiio \
        python3-soapysdr \
        python3-jsonschema \
        soapysdr-tools \
        libusb-1.0-0 \
        librtlsdr0 \
        libad9361-0 \
        libcodec2-1.2 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# SatDump's CLI from the stage above, and what it links: the libraries
# ldd names for satdump, libsatdump_core and its plugins, no more.
# python3-pil turns its PNGs and GeoTIFFs into the JPEGs and thumbnails
# api/wxsat/images serves (wxsat_decode.py). `satdump version` proves it
# loads: a missing library fails the build, not a pass.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjemalloc2 libvolk3.2 libnng1 libarmadillo14 libpng16-16t64 libfftw3-single3 \
        libzstd1 libcurl4t64 libtiff6 libgomp1 python3-pil \
    && rm -rf /var/lib/apt/lists/*
COPY --from=satdump /out/ /
RUN cd /tmp && HOME=/tmp satdump version 2>&1 | grep -q 'This is SatDump v1\.2\.' && rm -rf /tmp/.config
# >>> sdrplay-in-image
COPY --from=sdrplay /out/ /
RUN ldconfig && SoapySDRUtil --info | grep -q sdrPlaySupport
# <<< sdrplay-in-image

# The shared OpenHamShack libraries, exactly the pinned wheels: each one's
# hash is checked against tools/vendor/requirements.lock before it is
# unpacked into site-packages (no pip in the image; a wheel is a zip with
# nothing to run at install). sgp4 is the one that is not ohs-libs': PyPI's
# orbit propagator as a pure-Python wheel, for the weather-satellite passes.
# shack-packet is Radio's alone (APRS receive, ohsradio/aprs.py), as is
# shack-ui: NB has no APRS.
#
# shack-sdr (the decoder host, RTTY's and DAB's decoders, the codec loader,
# the RTL-SDR and SDRplay sources) is the one with native code: the wheel for
# this architecture, checked against tools/vendor/shack-sdr.lock.
#
# Then ohsdigi, the one decoder for FT8, FT4, Q65, JS8 and HSmodem (BETA-PLAN D9): the
# wheel for this architecture, checked against tools/vendor/ohsdigi.lock,
# and only its module kept, as ohscore/ohsdigi.abi3.so - where ohscore imports
# it from (ohscore.ohsdigi), exactly where the .deb puts it. COPY ohscore/
# below adds to that folder rather than replacing it. WSJT-X is not
# installed: jt9 would only be the fallback and the per-slot shadow (a
# second decode of every slot on the controller's CPU) and would bring Qt
# with it. Q65 and JS8 need no program either since ohsdigi decodes them
# (10/10/2026): the wheel must be one built since then, or the selftest
# below fails the build on them.
COPY tools/vendor/ /tmp/vendor/
RUN cd /tmp/vendor \
    && site="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && mkdir -p "$site" \
    && for w in shack_bandplan shack_client shack_pad shack_cw shack_rec shack_spectrum shack_ui shack_packet sgp4; do \
         f="$(ls ${w}-*.whl)"; \
         want="$(sed -n "s/^$(echo $w | tr _ -)==.*--hash=sha256:\([0-9a-f]*\).*/\1/p" requirements.lock)"; \
         echo "$want  $f" | sha256sum -c - || exit 1; \
         python3 -m zipfile -e "$f" "$site"; \
       done \
    && python3 -c "import shack_bandplan, shack_client, shack_pad, shack_cw, shack_rec, shack_spectrum, shack_ui, shack_packet.sdr, sgp4.api; shack_bandplan.load()" \
    && arch="$(uname -m)" \
    && f="$(ls shack_sdr-*-manylinux_*_${arch}.whl)" \
    && want="$(sed -n "s/^shack-sdr==.*--hash=sha256:\([0-9a-f]*\).*_${arch}$/\1/p" shack-sdr.lock)" \
    && echo "$want  $f" | sha256sum -c - \
    && python3 -m zipfile -e "$f" "$site" \
    && python3 -c "import shack_sdr; assert {'rtty', 'dab'} <= {e['id'] for e in shack_sdr.catalogue()}" \
    && f="$(ls ohs_ohsdigi-*-manylinux_*_${arch}.whl)" \
    && want="$(sed -n "s/^ohs-ohsdigi==.*--hash=sha256:\([0-9a-f]*\).*# ${arch}$/\1/p" ohsdigi.lock)" \
    && echo "$want  $f" | sha256sum -c - \
    && python3 -m zipfile -e "$f" /tmp/ohsdigi \
    && install -D -m 0644 /tmp/ohsdigi/ohsdigi/ohsdigi.abi3.so /opt/shack-radio/ohscore/ohsdigi.abi3.so \
    && rm -rf /tmp/vendor /tmp/ohsdigi

# radiosonde_auto_rx's programs from the stage above; a library they lack
# fails the build here, not the first sonde.
COPY --from=sonde /out/ /
RUN ! ldd /opt/shack-radio/sonde/* | grep -q "not found"

RUN useradd --uid 1000 --create-home --home-dir /data --shell /usr/sbin/nologin shack

COPY ohscore/ /opt/shack-radio/ohscore/
COPY ohsradio/ /opt/shack-radio/ohsradio/
COPY LICENSE pad-actions.json pad-layout.json /opt/shack-radio/
COPY entrypoint.sh /opt/shack-radio/entrypoint.sh

# Everything the engine keeps is on the data volume (module.yaml), so the
# read-only image is never written to.
ENV SHACK_FORM=store \
    OHS_RADIO_CONF=/data/config.json \
    OHS_RADIO_DATA=/data \
    OHS_RADIO_UI_CONF=/data/ui.json \
    SHACK_STATION_DB=/data/shack/station.db \
    HOME=/data \
    XDG_CACHE_HOME=/tmp/cache \
    SHACK_PORT=8080 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1

USER shack
WORKDIR /opt/shack-radio
# The image proves, as the user it runs as, that every decoder the app
# offers loads, that FT8 and FT4 decode a slot and that a DAB ensemble is
# found and its old-DAB station heard, before it can be
# packaged: 0.1.10-beta.1 shipped with no FT8 decoder and nothing said so.
# tools/store-check.sh runs the same check against a built image.
RUN python3 -m ohscore.selftest ohsradio
EXPOSE 8080
# entrypoint.sh starts SDRplay's API service, then becomes the server.
ENTRYPOINT ["/opt/shack-radio/entrypoint.sh"]
